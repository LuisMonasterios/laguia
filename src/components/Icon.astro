---
interface Props {
	name: string;
	size?: number;
	class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
	home: `<path d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1h-5v-7H9v7H4a1 1 0 01-1-1V9.5z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round"/>`,
	grid: `<rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75" fill="none"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75" fill="none"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75" fill="none"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75" fill="none"/>`,
	book: `<path d="M4 19.5A2.5 2.5 0 016.5 17H20" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" stroke="currentColor" stroke-width="1.75" fill="none"/>`,
	users: `<circle cx="9" cy="7" r="3.5" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M2 19.5c0-3.5 3.13-5.5 7-5.5s7 2 7 5.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/><circle cx="17" cy="8" r="2.5" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M15 19.5c0-2 1.8-3.5 4-3.5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	mail: `<rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round"/>`,
	star: `<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round"/>`,
	check: `<path d="M5 12l4 4 10-10" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
	arrow: `<path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
	clock: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	shield: `<path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round"/>`,
	twitter: `<path d="M4 4l16 16M4 20L20 4" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	instagram: `<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.75" fill="none"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.75" fill="none"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>`,
	youtube: `<rect x="2" y="6" width="20" height="12" rx="3" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M11 10l5 3-5 3v-6z" fill="currentColor"/>`,
	linkedin: `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M8 11v5M8 8v.01M12 16v-5c0-1.5 1-2.5 2.5-2.5S17 9.5 17 11v5" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	menu: `<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	close: `<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	search: `<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M16 16l4 4" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	productivity: `<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="1.75" fill="none"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	professions: `<rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke="currentColor" stroke-width="1.75" fill="none"/><path d="M12 12v2" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
	creativity: `<path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linejoin="round"/><path d="M5 19c1-2 3-3 7-3s6 1 7 3" stroke="currentColor" stroke-width="1.75" fill="none" stroke-linecap="round"/>`,
};

const path = icons[name] ?? icons.star;
---

<svg
	class={`icon ${className}`}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	aria-hidden="true"
	set:html={path}
/>

<style>
	.icon {
		flex-shrink: 0;
		display: inline-block;
		vertical-align: middle;
	}
</style>
