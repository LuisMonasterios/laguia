---
import type { CategoryKey } from '../config';
import { CATEGORIES } from '../config';
import Icon from './Icon.astro';

interface Props {
	title: string;
	description: string;
	slug: string;
	category: CategoryKey;
	pubDate: Date;
	image: string;
	imageAlt: string;
	readingTime?: number;
	featured?: boolean;
}

const {
	title,
	description,
	slug,
	category,
	pubDate,
	image,
	imageAlt,
	readingTime = 8,
	featured = false,
} = Astro.props;

const cat = CATEGORIES[category];
const formattedDate = pubDate.toLocaleDateString('es', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<article class:list={['card', featured && 'card--featured']}>
	<a href={`/articulos/${slug}/`} class="card__link">
		<div class="card__image">
			<img src={image} alt={imageAlt} width="400" height="220" loading="lazy" />
			{featured && <span class="card__featured-badge">Destacado</span>}
		</div>
		<div class="card__body">
			<div class="card__meta">
				<span class="badge" style={`background: ${cat.color}18; color: ${cat.color}`}>
					<Icon name={cat.icon} size={14} />
					{cat.label}
				</span>
				<span class="card__time">
					<Icon name="clock" size={14} />
					{readingTime} min
				</span>
			</div>
			<h2 class="card__title">{title}</h2>
			<p class="card__desc">{description}</p>
			<div class="card__footer">
				<time datetime={pubDate.toISOString()}>{formattedDate}</time>
				<span class="card__cta">
					Leer guía
					<Icon name="arrow" size={16} />
				</span>
			</div>
		</div>
	</a>
</article>

<style>
	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: transform var(--transition), box-shadow var(--transition);
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
	}

	.card--featured {
		border-color: #c7d2fe;
	}

	.card__link {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}

	.card__image {
		position: relative;
		overflow: hidden;
	}

	.card__image img {
		width: 100%;
		height: 200px;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.card:hover .card__image img {
		transform: scale(1.04);
	}

	.card__featured-badge {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.3rem 0.65rem;
		background: var(--gradient-brand);
		color: white;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		border-radius: 999px;
	}

	.card__body {
		padding: 1.25rem 1.35rem 1.35rem;
	}

	.card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	.card__time {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.card__title {
		margin: 0 0 0.5rem;
		font-size: 1.15rem;
		line-height: 1.35;
		transition: color var(--transition);
	}

	.card:hover .card__title {
		color: var(--color-accent-dark);
	}

	.card__desc {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		color: var(--color-text-muted);
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.card__cta {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-weight: 700;
		color: var(--color-accent-dark);
	}
</style>
