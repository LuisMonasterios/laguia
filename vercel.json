{
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "laguia.tech" }],
			"destination": "https://www.laguia.tech/:path*",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/api/(.*)",
			"headers": [
				{ "key": "Access-Control-Allow-Origin", "value": "*" },
				{ "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
			]
		}
	]
}
