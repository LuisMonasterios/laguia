# Variables locales — copia a .env (no subir .env a GitHub)

# Barra admin (/admin/acceso/)
PUBLIC_ADMIN_PASSWORD=tu-clave-segura-aqui

# OAuth GitHub para Panel CMS (/admin/)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL del sitio (producción)
SITE_URL=https://www.laguia.tech

# Dominios permitidos en el callback OAuth (separados por coma)
ALLOWED_ORIGINS=www.laguia.tech,laguia.tech,localhost:4321
